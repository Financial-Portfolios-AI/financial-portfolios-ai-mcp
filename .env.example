# Financial Portfolios AI MCP Server Configuration

# Portal Base URL (defaults to production if omitted)
FINANCIAL_PORTFOLIOS_BASE_URL=https://financial-portfolios.ai

# Personal API Token (generated via portal at https://financial-portfolios.ai/settings/api-tokens)
# Format: aqat_v1_<hex_string>
FINANCIAL_PORTFOLIOS_API_TOKEN=aqat_v1_your_token_here

# Server Configuration (for Streamable HTTP & SSE modes)
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_LOG_LEVEL=INFO
