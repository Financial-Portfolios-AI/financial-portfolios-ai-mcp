{
  "$comment": "Template: ${PUBLIC_ORIGIN} is replaced per deployment. Use clients/mcp_clients.dev.json or clients/mcp_clients.prod.json, or GET /mcp/manifests/mcp_clients.json from the deployment you want. Regenerate with: python scripts/render_manifests.py --clients",
  "claude_desktop": {
    "file_location": {
      "macos": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "windows": "%APPDATA%\\Claude\\claude_desktop_config.json"
    },
    "config": {
      "mcpServers": {
        "financial-portfolios-ai": {
          "command": "uv",
          "args": [
            "--directory",
            "/path/to/financial-portfolios-ai-mcp",
            "run",
            "financial-portfolios-ai-mcp",
            "stdio"
          ],
          "env": {
            "FINANCIAL_PORTFOLIOS_BASE_URL": "${PUBLIC_ORIGIN}",
            "FINANCIAL_PORTFOLIOS_API_TOKEN": "aqat_v1_your_token_here"
          }
        }
      }
    }
  },
  "cursor_ide": {
    "file_location": ".cursor/mcp.json or Settings > Features > MCP",
    "config": {
      "mcpServers": {
        "financial-portfolios-ai": {
          "url": "${PUBLIC_ORIGIN}/mcp",
          "headers": {
            "X-API-Key": "aqat_v1_your_token_here"
          }
        }
      }
    }
  },
  "windsurf_ide": {
    "file_location": "~/.codeium/windsurf/mcp_config.json",
    "config": {
      "mcpServers": {
        "financial-portfolios-ai": {
          "url": "${PUBLIC_ORIGIN}/mcp",
          "headers": {
            "X-API-Key": "aqat_v1_your_token_here"
          }
        }
      }
    }
  },
  "gemini_cli": {
    "command": "gemini mcp add --transport http financial-portfolios-ai ${PUBLIC_ORIGIN}/mcp --header 'X-API-Key: aqat_v1_your_token_here'"
  },
  "claude_code_cli": {
    "command": "claude mcp add --transport http financial-portfolios-ai ${PUBLIC_ORIGIN}/mcp --header 'X-API-Key: aqat_v1_your_token_here'"
  },
  "librechat_or_open_webui": {
    "config": {
      "mcpServers": {
        "financial-portfolios-ai": {
          "type": "streamable-http",
          "url": "${PUBLIC_ORIGIN}/mcp",
          "headers": {
            "X-API-Key": "aqat_v1_your_token_here"
          }
        }
      }
    }
  }
}
