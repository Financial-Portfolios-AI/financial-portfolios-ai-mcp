{
  "$comment": "Client configuration for the dev deployment (https://dev.financial-portfolios.ai). Generated from mcp_clients.json by scripts/render_manifests.py --clients. Do not edit.",
  "claude_desktop": {
    "file_location": {
      "macos": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "windows": "%APPDATA%\\Claude\\claude_desktop_config.json"
    },
    "config": {
      "mcpServers": {
        "fpai": {
          "command": "uv",
          "args": [
            "--directory",
            "/path/to/financial-portfolios-ai-mcp",
            "run",
            "financial-portfolios-ai-mcp",
            "stdio"
          ],
          "env": {
            "FINANCIAL_PORTFOLIOS_BASE_URL": "https://dev.financial-portfolios.ai",
            "FINANCIAL_PORTFOLIOS_API_TOKEN": "aqat_v1_your_token_here"
          }
        }
      }
    }
  },
  "cursor_ide": {
    "file_location": ".cursor/mcp.json or Settings > Features > MCP",
    "config": {
      "mcpServers": {
        "fpai": {
          "url": "https://dev.financial-portfolios.ai/mcp",
          "headers": {
            "X-API-Key": "aqat_v1_your_token_here"
          }
        }
      }
    }
  },
  "windsurf_ide": {
    "file_location": "~/.codeium/windsurf/mcp_config.json",
    "config": {
      "mcpServers": {
        "fpai": {
          "url": "https://dev.financial-portfolios.ai/mcp",
          "headers": {
            "X-API-Key": "aqat_v1_your_token_here"
          }
        }
      }
    }
  },
  "gemini_cli": {
    "command": "gemini mcp add -t http fpai https://dev.financial-portfolios.ai/mcp -H \"X-API-Key: $FINANCIAL_PORTFOLIOS_API_TOKEN\""
  },
  "claude_code_cli": {
    "command": "claude mcp add -t http fpai https://dev.financial-portfolios.ai/mcp -H \"X-API-Key: $FINANCIAL_PORTFOLIOS_API_TOKEN\""
  },
  "librechat_or_open_webui": {
    "config": {
      "mcpServers": {
        "fpai": {
          "type": "streamable-http",
          "url": "https://dev.financial-portfolios.ai/mcp",
          "headers": {
            "X-API-Key": "aqat_v1_your_token_here"
          }
        }
      }
    }
  }
}
